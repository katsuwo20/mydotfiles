{
  // ========================================
  // 基本・セキュリティ
  // ========================================
  "security.workspace.trust.enabled": false,
  "security.allowedUNCHosts": ["wsl.localhost"],

  // ========================================
  // ウィンドウ・表示
  // ========================================
  "workbench.startupEditor": "none",
  "workbench.editor.wrapTabs": true,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.reduceMotion": "on",
  "breadcrumbs.enabled": true,
  "editor.renderWhitespace": "all",
  "diffEditor.maxComputationTime": 0,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,

  // ========================================
  // ファイル
  // ========================================
  "files.autoGuessEncoding": true,
  "files.eol": "\n",

  // ========================================
  // ターミナル
  // ========================================
  "terminal.integrated.defaultProfile.windows": "PowerShell 7",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash",
    },
    "PowerShell 7": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    },
  },

  // ========================================
  // ネットワーク・リモート接続
  // ========================================
  "http.proxy": "http://proxy.kanto.sony.co.jp:10080",
  "https.proxy": "https://proxy.kanto.sony.co.jp:10080",
  "remote.autoForwardPortsSource": "hybrid",

  // ========================================
  // 言語・フォーマッター
  // ========================================
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },

  // Python
  "python.createEnvironment.trigger": "off",

  // PowerShell
  "powershell.promptToUpdatePowerShell": false,

  // ========================================
  // 拡張機能・関連付け
  // ========================================
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "workbench.editorAssociations": {
    "*.bin": "hexEditor.hexedit",
  },

  // ========================================
  // VSCode Neovim
  // ========================================
  "vscode-neovim.useWSL": true,
  "vscode-neovim.neovimExecutablePaths.linux": "/home/isono/.local/bin/nvim",
  "vscode-neovim.afterInitConfig": [
    "set cmdheight=999",
  ],
  "vscode-neovim.compositeKeys": {
    "jj": {
      "command": "vscode-neovim.escape",
    },
  },

  // Insert以外（Normal・Visualなど）でNeovimへ渡すCtrlキー
  "vscode-neovim.ctrlKeysForNormalMode": [
    "d", // Ctrl+D: 半画面下へスクロール
    "i", // Ctrl+I: ジャンプリストを進む（Tabと同じ）
    "l", // Ctrl+L: 画面を再描画
    "m", // Ctrl+M: Enterと同じ
    "o", // Ctrl+O: ジャンプリストを戻る
    "r", // Ctrl+R: Redo
    "t", // Ctrl+T: タグスタックを戻る
    "u", // Ctrl+U: 半画面上へスクロール
    "w", // Ctrl+W: ウィンドウ操作のプレフィックス
    "/", // Ctrl+/: NeovimへCtrl+/を送る
    "]", // Ctrl+]: タグ・定義へジャンプ
  ],

  // InsertモードでNeovimへ渡すCtrlキー
  "vscode-neovim.ctrlKeysForInsertMode": [
    "a", // Ctrl+A: 直前に挿入した文字列を再挿入
    "d", // Ctrl+D: インデントを1段減らす
    "j", // Ctrl+J: 改行
    "m", // Ctrl+M: Enterと同じ
    "o", // Ctrl+O: Normalモードのコマンドを1回だけ実行
    "r", // Ctrl+R: レジスタの内容を挿入
    "t", // Ctrl+T: インデントを1段増やす
    "u", // Ctrl+U: 行頭からカーソル直前まで削除
    "w", // Ctrl+W: カーソル直前の単語を削除
  ],

  // ========================================
  // GitHub Copilot・Chat
  // ========================================
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "systemverilog": true,
  },
  "chat.agent.enabled": true,
  "chat.agent.maxRequests": 1000000,
  "chat.viewSessions.orientation": "stacked",

  // ========================================
  // Git・GitLab・Atlassian
  // ========================================
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "atlascode.jira.enabled": false,
  "atlascode.bitbucket.enabled": false,

  // ========================================
  // AsciiDoc
  // ========================================
  "asciidoc.asciidoctor_command": "asciidoctor -r asciidoctor-diagram -a outdir=.asciidoctor -a imagesdir=resources -a imagesoutdir=resources",
  "asciidoc.preview.useEditorStyle": false,
  "asciidoc.use_asciidoctor_js": false,

  // ========================================
  // Hex Editor
  // ========================================
  "hexeditor.columnWidth": 16,
  "hexeditor.showDecodedText": true,
  "hexeditor.defaultEndianness": "little",
  "hexeditor.inspectorType": "aside",
  "editor.trimAutoWhitespace": false,
  "workbench.colorTheme": "Dark+",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://www.tool.sony.biz": {
      "approveRequest": true,
      "approveResponse": false
    }
  },
}
