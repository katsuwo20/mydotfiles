// 既定値を上書きするには、このファイル内にキー バインドを挿入します
[
    // ==========================
    // ターミナル関連のキーバインド
    // ==========================
    {
        // ターミナルを開く/閉じる
        "key" : "ctrl+t",
        "command": "workbench.action.togglePanel"
    },
    {
        // ターミナル内で前のタブに移動
        "key": "ctrl+shift+,",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        // ターミナル内で次のタブに移動
        "key": "ctrl+shift+.",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },

    {
        // Ctrl+Jによる下部パネルの表示/非表示を無効化
        "key": "ctrl+j",
        "command": "-workbench.action.togglePanel"
    },
    {
        // Ctrl+Kによるターミナルのクリアを無効化
        "key": "ctrl+k",
        "command": "-workbench.action.terminal.clear"
    },
    {
        // ターミナル内ではCtrl+Gによる「指定行へ移動」を無効化
        "key": "ctrl+g",
        "command": "-workbench.action.gotoLine",
        "when": "terminalFocus"
    },
    {
        // ターミナルへCtrl+G（BEL: \u0007）を送信
        "key": "ctrl+g",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0007"
        },
        "when": "terminalFocus"
    },

    // ==========================
    // エディタ関連のキーバインド
    // ==========================
    // Ctrl+Lで次のエディタへ移動（NeovimのInsertモードでは無効化）
    {
        "key": "ctrl+l",
        "command":"workbench.action.nextEditor",
        "when": "!terminalFocus && !sideBarFocus && neovim.mode != insert"
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.previousEditor",
        "when": "!terminalFocus && !sideBarFocus && neovim.mode !== insert '"
    },

    // ==========================
    // LSP関連のキーバインド
    // ==========================
    // 定義へ移動
    // {
    //     "key": "g d",
